# EverTree Solutions Environment Configuration

# Turso Cloud Database (Primary)
TURSO_DB_URL=libsql://evertree-eshu1412.aws-ap-south-1.turso.io
TURSO_DB_KEY=your_turso_db_key_here
DATABASE_MODE=turso

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
SEED_DEMO_DATA=false

# ActiveProspect TrustedForm Server-Side Retention API Key
TRUSTEDFORM_API_KEY=82ee82d4bb767148ccb8741c713b8998

# ActiveProspect TrustedForm TCPA Certification (Client-side script loader)
VITE_TRUSTEDFORM_ENABLED=true

# Meta / Facebook Pixel Tracking ID (Client-side)
VITE_META_PIXEL_ID=
